# Copy to .env or application-local.properties (both gitignored) for local overrides
DB_URL=jdbc:postgresql://localhost:5432/dyfi_wildlife_centre
DB_USERNAME=postgres
DB_PASSWORD=change_me
APP_UPLOAD_DIR=uploads
APP_BOOTSTRAP_TRANSPORT=true
# Used only when booting an empty database (e.g. Docker Compose) to seed dyfi_admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me_for_bootstrap
